    private static BlackHoleFallbackGuard guard() {
        if (guard == null) {
            guard = new BlackHoleFallbackGuard(LOG_SINK);
        }
        return guard;
    }

    private static boolean enabled() {
        ensureTuningInit();
        try {
            return BlackHoleTuning.enabled();
        } catch (Throwable t) {
            return false;                               // 理论上到不了（tuning 不抛）；防御
        }
    }

    /**
     * 把 toml 的默认值灌进 {@link BlackHoleTuning}（<b>只生效一次</b>）。
     *
     * <p>⚠️ 为什么不放构造期/静态初始化：配置在 {@code @Mod} 构造器里才 register，
     * 而本类可能先被 Forge 的事件订阅扫描加载（那时配置还没 load，{@code .get()} 会抛）。
     * ⇒ 放在"第一次真的要画"的位置 + try/catch，失败就下一帧再来（{@code initialized} 仍是 false）。
     */
    private static void ensureTuningInit() {
        if (BlackHoleTuning.isInitialized()) {
            return;
        }
        try {
            BlackHoleTuning.initFromConfig(
                    ShanhaiClientConfig.blackholeEnabled(),
                    ShanhaiClientConfig.blackholeScale(),
                    ShanhaiClientConfig.blackholeStrength());
            ShanhaiMod.LOGGER.info("{} tuning_init {} {}", PREFIX, BlackHoleTuning.describe(),
                    BlackHoleTuning.ranges());
        } catch (Throwable ignored) {
            // 配置还没加载 ⇒ 下一帧再试
        }
    }

    /** 这一帧真正用的视界半径（格）= 常数 × 运行期倍率。 */
    public static double rsBlocks() {
        ensureTuningInit();
        return RS_BLOCKS * BlackHoleTuning.scale();
    }

    /**
     * 这一帧的中心：<b>命令覆盖优先</b>，否则 toml；两者都做"整数维 +0.5"补正。
     *
     * <p>补正只在<b>值变化时</b>做一次并打一行日志（{@code center_snapped}），
     * 否则每帧一行会把日志刷爆。
     */
    private static double[] resolveCenter() {
        final double[] override = BlackHoleTuning.centerOverride();
        if (override != null) {
            centerRawCache = "\u0000cmd";               // 让 toml 一侧下次重新解析
            return override;
        }
        final String raw;
        try {
            raw = ShanhaiClientConfig.blackholeCenter();
        } catch (Throwable t) {
            return null;
        }
        if (!Objects.equals(raw, centerRawCache)) {
            centerRawCache = raw;
            final double[] parsed = BlackHoleDebugSpec.parse(raw);
            if (parsed == null) {
                centerCache = null;
                if (raw != null && !raw.trim().isEmpty() && !centerWarned) {
                    centerWarned = true;
                    ShanhaiMod.LOGGER.warn("{} {} value=\"{}\"（[debug] blackhole_center 必须是 \"x y z\" 三个数字）",
                            PREFIX, BlackHoleDebugSpec.REASON_MALFORMED, raw);
                }
            } else {
                final BlackHoleDebugSpec.Snap snap = BlackHoleDebugSpec.snapToCenter(parsed);
                centerCache = snap.coords;
                if (snap.snapped) {
                    ShanhaiMod.LOGGER.info(
                            "{} center_snapped src=toml dx={} dy={} dz={} from={} to={} note=整数坐标按方块中心+0.5",
                            PREFIX, f1(snap.dx), f1(snap.dy), f1(snap.dz),
                            BlackHoleDebugSpec.format(parsed), BlackHoleDebugSpec.format(snap.coords));
                }
            }
        }
        return centerCache;
    }

    private static void noteBoot(double[] center, double dist, boolean shaderpack) {
        if (bootLogged) {
            return;
        }
        bootLogged = true;
        ShanhaiMod.LOGGER.info("{} boot level={} center={} dist={} rs={} stage=AFTER_WEATHER shaderpack={}",
                PREFIX, guard().level(), BlackHoleDebugSpec.format(center), f1(dist), f1(rsBlocks()),
                shaderpack);
    }

    private static void noteIdle() {
        if (idleLogged) {
            return;
        }
        idleLogged = true;
        ShanhaiMod.LOGGER.info("{} idle reason={}（在 config/shanhai-client.toml 的 [debug] blackhole_center "
                + "填 \"x y z\" 即可出图；本件默认什么都不画）", PREFIX, BlackHoleDebugSpec.REASON_EMPTY);
    }

    /**
     * 光影包（Oculus / Iris）是否正跑着一套 shaderpack。
     *
     * <p>为什么要问：iris 在 shaderpack 生效时把世界画进<b>它自己的</b>帧缓冲，
     * 到 {@code renderLevel} 的末尾（{@code finalizeLevelRendering}）才合成回主渲染目标
     * （取证：{@code net/irisshaders/iris/mixin/MixinLevelRenderer#iris$endLevelRender} 调
     * {@code pipeline.finalizeLevelRendering()}；{@code IrisRenderingPipeline}/{@code FinalPassRenderer}
     * 才引用主渲染目标）。我们在 AFTER_WEATHER 去拷主目标，拿到的会是<b>上一帧的合成结果</b>
     * ⇒ 透镜会把旧画面搬来搬去（比不画还糟）⇒ 这种情况直接走二级。
     *
     * <p>⚠️ 这条是<b>本件最大的未验证假设</b>（只能在装了光影包的实机上验），报告 §7 已列。
     * 反射查不到 ⇒ 当作"没开"（宁可画一级）。
     */
    private static boolean irisShaderpackActive() {
        final int frame = frameCounter++;
        if (frame - irisCheckedFrame < 20) {          // 每秒重查一次（玩家可能在游戏里切光影）
            return irisActive;
        }
        irisCheckedFrame = frame;
        try {
            if (!ModList.get().isLoaded("oculus") && !ModList.get().isLoaded("iris")) {
                irisActive = false;
                return false;
            }
            final Class<?> iris = Class.forName("net.irisshaders.iris.Iris");
            final Object pipelineManager = iris.getMethod("getPipelineManager").invoke(null);
            final Object pipeline = pipelineManager.getClass().getMethod("getPipeline").invoke(pipelineManager);
            irisActive = pipeline instanceof java.util.Optional<?> opt && opt.isPresent();
        } catch (Throwable t) {
            irisActive = false;
        }
        return irisActive;
    }

    /** 资源重载后调用：作废 shader / 拷贝自检缓存（{@link BlackHoleReloadHook} 转调）。 */
    public static void onResourceReload() {
        closeShaderQuietly();
        shaderTried = false;
        copyVerified = false;
        lensOnLogged = false;
        lensEnvLogged = null;
        if (guard != null) {
            guard.reset();
        }
    }

