    /** 50 格容器的 contents-changed（`setStackInSlot` / 玩家拖入都会走到这里）。 */
    private void shanhaiOnWildcardInventoryChanged() {
        if (this.isRemote()) {
            return;
        }
        this.shanhaiRefreshWildcardConfigType();
        this.shanhaiRefreshWildcardMask();
