# ═══════════════════════════════════════════════════════════════════════════════
#  shanhai重构 — .gitignore
#  设计口径（2026-09-27 用户点单）：仓库只收【源码 / 脚本 / 文档 / 配方转写产物】，
#  一切【大体积原始物】【临时装置】【快照】都不入库（它们在磁盘上照常存在）。
# ═══════════════════════════════════════════════════════════════════════════════

# ── DSH 工作区数据（含记忆库）—— 绝不动、绝不入库 ──────────────────────────────
.dsh/
.dsh-meow/
.dsh-vision-router/
.agent-teams/

# ── temp\ 全是临时的（测试装置 / 证据 / 探针 / 待删）───────────────────────────
temp/

# ── originals\ 是原始物与快照（体积大；磁盘保留，不入库）───────────────────────
originals/

# ── 构建产物与依赖（可重建）────────────────────────────────────────────────────
shanhai-rewrite/build/
shanhai-rewrite/.gradle/
shanhai-rewrite/run/
# 🔴 libs\ 里 33 个 jar ≈ 105 MB ⇒ 不入库；但【清单】要进去（否则别人不知道要准备哪些）
#    ⚠️ 必须写 `libs/*` 而不是 `libs/` —— 目录级忽略会让下面的 `!` 例外【失效】
shanhai-rewrite/libs/*
!shanhai-rewrite/libs/README.md
**/build/
**/.gradle/

# ── 工具链的大体积数据（gtl-cost 的导出/索引、gtl-tags 的 tag 快照）──────────────
tools/gtl-cost/
tools/gtl-tags/
tools/out/

# ── 二进制 / 归档 ──────────────────────────────────────────────────────────────
*.jar
*.zip
*.7z
*.tar
*.gz
!gradle/wrapper/gradle-wrapper.jar

# ── 备份与破损件（命名约定）───────────────────────────────────────────────────
*.before-*
*.before_*
*.broken-*
*.bak
*.old
*~

# ── 运行时残渣 ────────────────────────────────────────────────────────────────
*.log
logs/
game.pid
*.pid
hs_err_pid*.log
replay_pid*.log

# ── 编辑器 / 系统 ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.swp
Thumbs.db
desktop.ini
# ── 🔴 2026-09-27 用户点单：「git 仓库只有 java 和 kjs，要传 github」────────────────
#    这 4 个目录【原地不动】（生成器还指着它们），只是不入库。
recipe-convert/
handoff/
tools/
docs/
# ── 解包 jar 的残渣（出现在【仓库根目录】，看着像源码，永远不入库）──
/META-INF/
/com/
*.class
/v5_designs.py
/v5_genesis.py
